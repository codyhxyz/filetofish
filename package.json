{
  "name": "filetofish",
  "version": "1.0.0",
  "description": "Drop in any file, it comes back as a fish. The same file always gives the same fish.",
  "main": "index.js",
  "scripts": {
    "test": "node test/sea-time.mjs && node test/celestial-identity.mjs",
    "soundtrack": "python3 soundtrack/render.py",
    "soundtrack:check": "python3 soundtrack/render.py --check",
    "soundtrack:suite": "python3 soundtrack/ac_suite.py",
    "soundtrack:catalog": "python3 soundtrack/kk_catalog.py",
    "soundtrack:studio": "open soundtrack/soundfont_studio.html",
    "soundtrack:real": "open soundtrack/real_soundfont.html",
    "soundtrack:shootout": "open soundtrack/engine_shootout.html",
    "soundtrack:jukebox": "open soundtrack/player.html",
    "soundtrack:inspect": "node build.mjs && open dist/score/index.html",
    "soundtrack:inspect:check": "node soundtrack/inspector-check.mjs",
    "soundtrack:play": "python3 soundtrack/ac_suite.py && afplay soundtrack/previews/ac_suite_album.wav",
    "soundtrack:mvp": "python3 soundtrack/dock_mvp.py && afplay soundtrack/previews/dock_mvp.wav"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "esbuild": "^0.28.2",
    "soundfont-player": "^0.12.0",
    "three": "^0.185.1"
  }
}
